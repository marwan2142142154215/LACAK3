TZ=UTC
NODE_ENV=development
PORT=3333
HOST=127.0.0.1
APP_NAME=SMB Gateway
LOG_LEVEL=info
APP_KEY=
APP_URL=http://127.0.0.1:3333

# Laravel origin URL. This is an internal service URL in production.
LARAVEL_INTERNAL_URL=http://127.0.0.1:8000

# Redis is ephemeral presence/replay state; PostgreSQL remains Laravel-owned.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate independently for local/staging/production and share only with Laravel.
GATEWAY_SHARED_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
WS_PATH=/ws
WS_ALLOWED_ORIGINS=http://localhost:5173,https://app.lacaksmbbot.com
WS_AUTH_TIMEOUT_MS=5000
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=120
WS_PRESENCE_TTL_SECONDS=90
