APP_NAME=SMB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=smb_local
DB_USERNAME=smb_local
DB_PASSWORD=replace-with-a-local-only-password
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_TOKEN_EXPIRATION_MINUTES=60
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8080,127.0.0.1:8080,localhost:8000,127.0.0.1:8000,app.lacaksmbbot.com
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,https://app.lacaksmbbot.com
# Production SPA on app.lacaksmbbot.com and API on api.lacaksmbbot.com must share the parent-domain session cookie.
# SESSION_DOMAIN=.lacaksmbbot.com
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SMB_STORAGE_PATH=./runtime/storage
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-another-local-only-password
REDIS_PORT=6379
ACTIVITY_LOGGER_TABLE_NAME=audit_logs
GATEWAY_SHARED_SECRET=
GATEWAY_CLOCK_SKEW_SECONDS=60
GATEWAY_HEALTH_URL=http://gateway:3333/api/v1/health
CLOUDFLARE_TUNNEL_PROBE_URL=https://app.lacaksmbbot.com/healthz
DEVICE_LOCATION_RETENTION_DAYS=90
SMB_RELEASE_CERT_SHA256=
TELEGRAM_UPDATE_RECEIPT_RETENTION_DAYS=7

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
